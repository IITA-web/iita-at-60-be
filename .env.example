# Local development uses SQLite by default. For production, use PostgreSQL.
DATABASE_URL=sqlite:///./iita_at60.db

# IMPORTANT: replace both values before deployment.
SECRET_KEY=replace-this-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisAdminPassword123!

# CORS origins, comma separated
CORS_ORIGINS=http://localhost:3000

# Sentiment model. First use downloads the model and may take a while.
# This model returns positive/negative labels; the API maps the score to a conservative neutral band.
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
SENTIMENT_NEUTRAL_BAND=0.15
